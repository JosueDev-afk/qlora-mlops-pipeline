# ── never commit the real .env ───────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # es-MX voice for the agent (Flash v2.5)
GEMINI_API_KEY=               # H1 frontier arm + eval judge only. Free tier: send the eval set, nothing else
HF_TOKEN=

QWEN_BASE_URL=http://localhost:8000/v1   # make serve
LAYA_BASE_URL=http://localhost:8001      # make serve-laya
LAYA_API_KEY=                            # optional: laya.serve then requires a bearer token
QWEN_MODEL=                              # served model name; defaults to train.base_model
ELEVENLABS_ENABLE_LOGGING=true           # false = zero retention, enterprise plans only
DEMO_KAFKA_BOOTSTRAP=                    # e.g. localhost:29092 to send demo telemetry

POSTGRES_USER=agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=voice_agent

MLFLOW_TRACKING_URI=http://mlflow:5000

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
AIRFLOW_UID=50000
