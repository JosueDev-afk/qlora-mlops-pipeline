{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParseDatetimeOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["datetime_iso", "precision", "confidence"],
  "properties": {
    "datetime_iso": { "type": ["string", "null"], "format": "date-time" },
    "precision":    { "enum": ["exact", "day", "half_day", "week", "unresolved"],
                      "description": "half_day covers 'en la tarde'" },
    "alternatives": { "type": "array", "items": { "type": "string", "format": "date-time" },
                      "maxItems": 3 },
    "excluded":     { "type": "array", "items": { "type": "string" },
                      "description": "e.g. 'cualquier día menos el lunes'" },
    "confidence":   { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
