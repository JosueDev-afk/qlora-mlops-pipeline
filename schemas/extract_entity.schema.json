{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtractEntityOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["field", "normalized_value", "confidence", "needs_reprompt"],
  "properties": {
    "field":            { "enum": ["name", "phone", "email"] },
    "normalized_value": { "type": ["string", "null"],
                          "description": "E.164 for phone, lowercase for email, null if not captured" },
    "raw_span":         { "type": ["string", "null"] },
    "confidence":       { "type": "number", "minimum": 0, "maximum": 1 },
    "needs_reprompt":   { "type": "boolean" },
    "reprompt_reason":  { "enum": ["low_confidence", "invalid_format", "partial", "not_provided", null] }
  }
}
